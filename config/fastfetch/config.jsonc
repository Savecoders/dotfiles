{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch", // Built-in logo name or file path
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2,
    },
    "color": {
      // Override logo colors
      "1": "blue",
      "2": "green",
      "3": "cyan",
    },
  },
  "display": {
    "separator": ": ",
    "key": {
      "type": "both",
    },
    "bar": {
      "border": {
        "left": "\uee00",
        "leftElapsed": "\uee03",
        "right": "\uee02",
        "rightElapsed": "\uee05",
      },
      "char": {
        "total": "\uee01",
        "elapsed": "\uee04",
      },
      "color": {
        "total": null,
      },
    },
    "percent": {
      "type": ["bar"],
    },
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "break",
    "colors",
  ],
}
