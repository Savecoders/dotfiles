{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii/ascii-art.txt", // Built-in logo name or file path
    "padding": {
      "top": 0,
      "left": 0,
      "right": 4
    },
    "color": {
      "1": "cyan",
      "2": "blue",
      "3": "green"
    }
  },
  "display": {
    "separator": "    ",
    "key": {
      "type": "icon",
      "paddingLeft": 2
    },
    "bar": {
      "border": {
        "left": "\uee00",
        "leftElapsed": "\uee03",
        "right": "\uee02",
        "rightElapsed": "\uee05"
      },
      "char": {
        "total": "\uee01",
        "elapsed": "\uee04"
      }
    },
    "percent": {
      "type": [
        "bar"
      ]
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐",
      "outputColor": "black"
    },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "black"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 14
    }
  ]
}
