// light mode

configuration {
    modi: "drun,window,run";
    icon-theme: "Mkos-Big-Sur";
    show-icons: true;
    terminal: "kitty";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    drun-display-format: "{icon} {name}";
    sidebar-mode: true;
    display-drun: "";
    display-run: "";
    display-window: "";
}

* {
    bg: #FFFFFF;
    bg-col:  #F2F2F2;
    bg-col-light: #F2F2F2;
    border-col: #F2F2F2;
    selected-col: #FFFFFF;
    fg: #AEAEB2;
    blue: #5AA8FF;
    fg-col: #BCBCC0;
    fg-col2: #db7272;
    grey: #AEAEB2;
    rad: 4px;
}


element-text, element-icon{
    background-color: inherit;
    text-color:       inherit;
}

window {
    background-color: @bg;
    border-radius: 12px;
    location: center;
    padding: 12px;
    width: 32%;
    border: 2px;
    border-color: @border-col;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, view-container];
    background-color: #0000;
}

view-container{
    expand: true;
    children: [listview];
    orientation: horizontal;
    border-radius: @rad;
    border-color: @border-col;
    background-color: @bg;
}

// Icon and text in the prompt
prompt{
    text-color: @fg-col;
    background-color: @bg;
    font: "SF Pro Display 24";
    horizontal-align: 0;
    padding: 8px 0 0 8px;
}

// Input bar with prompt and entry
inputbar {
    children: [ prompt, entry ];
    orientation: horizontal;
    padding: 4px 16px;
    border: 0px 0px 2px 0px;
    background-color: @bg;
    border-color: @border-col;
}

// Search entry
entry {
    background-color: @bg;
    text-color: @fg-col;
    font: "SF Pro Display 14";
    padding: 12px;
    placeholder: "Search with the app name or command";
}

listview {
    margin: 4px 0 0 0;
    cycle: false;
    dynamic: true;
    border-radius: @rad;
    layout: vertical;
    lines: 7;
    background-color: @bg;
}

element {
    padding: 1%;
    orientation: horizontal;
    border-radius: @rad;
    background-color: @bg;
}

element-icon {
    size: 20px;
    padding: 4px;
    border-radius: @rad;
}

element-text{
    expand: true;
    horizontal-align: 0;
    margin: 0 8px;
    font: "SF Pro Display 14";
    text-color: @fg;
}


// Selected is the element that is currently highlighted
// is hovered over by the mouse cursor

element-icon selected {
    background-color: @blue;
}

element selected {
    background-color: @bg-col;
    padding: 0px;
    margin: 0px;
    text-color: @fg-col2;
    font: "SF Pro Display Semibold 14";
}

element selected, element-text selected {
    text-color: @blue;
}

listview, element, element-selected, element-text { cursor: pointer; }
entry { cursor: text; }
