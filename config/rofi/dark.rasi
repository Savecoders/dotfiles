// dark theme for the application launcher

configuration {
    modi: "drun,window,run";
    icon-theme: "WhiteSur-dark";
    show-icons: true;
    terminal: "kitty";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    drun-display-format: "{icon} {name}";
    display-drun: "";
    display-window: "";
    display-run: "";
    sidebar-mode: true;
}

* {
    bg: #1C1C1E;
    bg-col:  #242426;
    bg-col-light: #242426;
    border-col: #242426;
    selected-col: #1C1C1E;
    fg: #E5E5EA;
    blue: #0A84FF;
    fg-col: #E5E5EA;
    fg-col2: #FF768E;
    grey: #E5E5EA;
    rad: 4px;
}


element-text, element-icon{
    background-color: inherit;
    text-color:       inherit;
}

window {
    background-color: @bg;
    border-radius: 16px;
    location: center;
    padding: 1px;
    width: 32%;
    border: 1px;
}

mainbox {
    spacing: 12px;
    border-radius: 16px;
    children: [ inputbar, view-container ];
    background-color: #0000;
    border: 1px;
    padding: 12px;
    orientation: vertical;
    border-color: @border-col;
}

view-container{
    expand: true;
    children: [listview];
    orientation: horizontal;
    border-radius: @rad;
    border-color: @border-col;
    background-color: @bg;
}

// Input bar with prompt and entry
inputbar {
    children: [ prompt, entry ];
    orientation: horizontal;
    padding: 4px 16px;
    border: 0px 0px 2px 0px;
    background-color: @bg;
    border-color: @border-col;
}

// Search entry
entry {
    background-color: @bg;
    text-color: @fg-col;
    font: "SF Pro Display 14";
    padding: 12px 0;
    placeholder: "Search...";
}


// Icon and text in the prompt
prompt {
    text-color: @fg-col;
    background-color: @bg;
    font: "DankMono Nerd Font 14";
    padding: 12px 24px 12px 8px;
}

listview {
    margin: 8px 0;
    cycle: false;
    dynamic: true;
    border-radius: @rad;
    layout: vertical;
    lines: 7;
    background-color: @bg;
}

element {
    padding: 1%;
    orientation: horizontal;
    border-radius: @rad;
    background-color: @bg;
}

element-icon {
    size: 24px;
    padding: 4px;
    border-radius: @rad;
}

element-text{
    expand: true;
    horizontal-align: 0;
    margin: 0 8px;
    font: "SF Pro Display 16";
    text-color: @fg;
}


// Selected is the element that is currently highlighted
// is hovered over by the mouse cursor

element-icon selected {
    background-color: @blue;
}

element selected {
    background-color: @bg-col;
    padding: 0px;
    margin: 0px;
    text-color: @fg-col2;
    font: "SF Pro Display Semibold 16";
}

element selected, element-text selected {
    text-color: @blue;
}

listview, element, element-selected, element-text { cursor: pointer; }
entry { cursor: text; }
