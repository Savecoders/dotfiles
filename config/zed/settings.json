{
  "icon_theme": "Catppuccin Mocha",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/target",
    "**/node_modules",
    "**/__pycache__",
    "**/vendor",
    "**/.venv",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/*.egg-info",
    "**/*.egg",
    "**/dist",
    "**/build",
    "**/_build",
    "**/site",
    "**/bower_components",
    "**/lib",
    "**/lib64",
    "**/share",
    "**/Scripts",
    "**/third_party",
    "**/third-party",
    "**/venv",
    "**/venvs",
    "**/virtualenv",
    "**/virtualenvs",
    "**/env",
    "**/envs"
  ],
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [
      "**/.env*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/.dev.vars",
      "**/secrets.yml"
    ],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "show_edit_predictions": true,
  "terminal": {
    "shell": "system",
    "line_height": {
      "custom": 1.25
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    }
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "ui_font_size": 18,
  "buffer_font_size": 20,
  "agent_ui_font_size": 18,
  "ui_font_family": "DankMono Nerd Font",
  "buffer_font_family": "DankMono Nerd Font",
  "formatter": "language_server",
  "preferred_line_length": 80,
  "theme": {
    "mode": "system",
    "light": "Savior Matugen (Blur Heavy)",
    "dark": "Savior Matugen (Blur Heavy)"
  },
  "tab_size": 2,
  "active_pane_modifiers": {
    "inactive_opacity": 1.0
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 2,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "languages": {
    "Shell Script": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"]
        }
      }
    }
  }
}
