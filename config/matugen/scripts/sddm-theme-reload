#!/usr/bin/env bash

# Reload & Sync SDDM theme configuration and wallpaper from Quickshell
USER_HOME="$HOME"
SDDM_THEME_USER="$USER_HOME/.config/sddm/themes/savior"
SDDM_THEME_SYS="/usr/share/sddm/themes/savior"
ACTIVE_WALL="$USER_HOME/.current.wall"

# Update user sddm theme background atomically from ~/.current.wall if present
if [[ -f "$ACTIVE_WALL" ]]; then
  cp "$ACTIVE_WALL" "$SDDM_THEME_USER/background.png.tmp" 2>/dev/null && mv -f "$SDDM_THEME_USER/background.png.tmp" "$SDDM_THEME_USER/background.png" 2>/dev/null || true
fi

# Sync to system SDDM directory atomically if installed & writable
if [[ -d "$SDDM_THEME_SYS" ]]; then
  if [[ -w "$SDDM_THEME_SYS/theme.conf" || -w "$SDDM_THEME_SYS" ]]; then
    cp "$SDDM_THEME_USER/theme.conf" "$SDDM_THEME_SYS/theme.conf.tmp" 2>/dev/null && mv -f "$SDDM_THEME_SYS/theme.conf.tmp" "$SDDM_THEME_SYS/theme.conf" 2>/dev/null || true
  fi
  if [[ -f "$SDDM_THEME_USER/background.png" && (-w "$SDDM_THEME_SYS/background.png" || -w "$SDDM_THEME_SYS") ]]; then
    cp "$SDDM_THEME_USER/background.png" "$SDDM_THEME_SYS/background.png.tmp" 2>/dev/null && mv -f "$SDDM_THEME_SYS/background.png.tmp" "$SDDM_THEME_SYS/background.png" 2>/dev/null || true
  fi
fi
